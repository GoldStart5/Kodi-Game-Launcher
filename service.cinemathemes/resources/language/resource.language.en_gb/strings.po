msgctxt "#30201"
msgid "Full path to your portable mpv.exe, or to the folder that contains it. special:// paths also work. Leave empty to use mpv from the system PATH. Without mpv, no theme can play."
msgstr ""

msgctxt "#30202"
msgid "Optional extra command-line options for mpv, for example --audio-device=wasapi/{device-id} to pick the audio output. mpv's own config file is not read, so use this field instead. Leave empty if unsure."
msgstr ""

msgctxt "#30203"
msgid "Any audio file whose name contains this word is a theme, for example theme.mp3 or Main Theme.flac. Used for root, movie and show themes. The global theme folder uses every audio file in it."
msgstr ""

msgctxt "#30204"
msgid "Movie and show themes: when an item's folder holds several theme files, Random order shuffles them and In order plays them alphabetically (theme 2 before theme 10)."
msgstr ""

msgctxt "#30205"
msgid "Movie and show themes: repeat when finished. Off: the theme plays once and then stays silent until another theme starts."
msgstr ""

msgctxt "#30206"
msgid "Movie and show themes: start the first track at a random point (between 5% and 70% of its length) instead of the beginning."
msgstr ""

msgctxt "#30207"
msgid "Root themes: when the source folder holds several theme files, Random order shuffles them and In order plays them alphabetically (theme 2 before theme 10)."
msgstr ""

msgctxt "#30208"
msgid "Root themes: repeat when finished. Off: the root theme plays once and then stays silent until another theme starts."
msgstr ""

msgctxt "#30209"
msgid "Root themes: start the first track at a random point (between 5% and 70% of its length) instead of the beginning."
msgstr ""

msgctxt "#30210"
msgid "Playback volume of all themes, from 0 to 100. Fade times are measured from silence to this level."
msgstr ""

msgctxt "#30211"
msgid "How long a theme takes to fade in when it starts from silence: the first theme, after a pause (Kodi back in focus, playback ended, back in the library), and when the global theme follows a library theme. Milliseconds; 0 means no fade."
msgstr ""

msgctxt "#30212"
msgid "How long a theme takes to fade out to silence: Kodi loses focus, Kodi plays media, you leave the library with no global theme, nothing applies, or a library theme hands over to the global theme. Milliseconds; 0 means no fade."
msgstr ""

msgctxt "#30213"
msgid "Fade-out of the old theme when another library theme follows it, or when the global theme is followed by a library theme. Between 200 and 5000 milliseconds."
msgstr ""

msgctxt "#30214"
msgid "Fade-in of the new theme in those same changes (library theme to library theme, global theme to library theme). Between 200 and 5000 milliseconds."
msgstr ""

msgctxt "#30215"
msgid "Play the root theme (the theme file in the root of each video source folder) while browsing. Off: it never plays. A source with no root theme counts the same as off."
msgstr ""

msgctxt "#30216"
msgid "When the root theme is off or not found, the global theme takes its place in the library: in lists, and in info, seasons and episodes that have no theme of their own. Needs the global theme to be enabled with a folder set."
msgstr ""

msgctxt "#30217"
msgid "Only used when neither the root theme nor the global theme covers the lists. On: the movie or show you are on plays its own theme. Off: nothing plays while hovering, only in info dialogs, seasons and episodes."
msgstr ""

msgctxt "#30218"
msgid "Fade out and pause when another window is in front of Kodi, then fade in and continue when Kodi is in front again. Uses the Windows foreground window."
msgstr ""

msgctxt "#30219"
msgid "Fade out and pause while Kodi plays a video, trailer or music, then continue when playback ends."
msgstr ""

msgctxt "#30220"
msgid "Only used when there is no global theme. On: the theme fades out and pauses outside the video library (home screen, settings...). Off: it keeps playing there. With a global theme set, the global theme plays there instead."
msgstr ""

msgctxt "#30221"
msgid "How long the selection must stay on an item before the theme changes, in milliseconds. Stops themes restarting while you scroll quickly. 0 changes at once."
msgstr ""

msgctxt "#30222"
msgid "Master switch for the global theme. Off: it is ignored, as if no folder was set."
msgstr ""

msgctxt "#30223"
msgid "A folder of audio files, for example theme 1, theme 2, theme 3. Every audio file in it belongs to the global theme. It plays outside the video library, and in the library when 'Global theme replaces the root theme' applies."
msgstr ""

msgctxt "#30224"
msgid "Random order shuffles the files in the global theme folder, In order plays them alphabetically (theme 2 before theme 10)."
msgstr ""

msgctxt "#30225"
msgid "Repeat all tracks when the last one ends. Recommended, otherwise the global theme ends and the background goes silent."
msgstr ""

msgctxt "#30226"
msgid "Start the first track of the global theme at a random point (between 5% and 70% of its length). When the theme is resumed, it continues from where it stopped instead."
msgstr ""

msgctxt "#30227"
msgid "When the global theme comes back after a library theme or a pause took over: continue the same track from the same point, or start a new track."
msgstr ""

msgctxt "#30228"
msgid "Write detailed lines to kodi.log, starting with [service.cinemathemes]. Turn this on when reporting a problem."
msgstr ""
