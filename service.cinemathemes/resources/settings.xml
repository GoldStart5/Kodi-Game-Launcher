<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="service.cinemathemes">

    <category id="player" label="30000">
      <group id="mpv" label="30010">
        <setting id="mpv_path" type="path" label="30100" help="30101">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
            <writable>false</writable>
          </constraints>
          <control type="button" format="file">
            <heading>30100</heading>
          </control>
        </setting>
        <setting id="mpv_extra_args" type="string" label="30102" help="30103">
          <level>1</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30102</heading>
          </control>
        </setting>
      </group>
      <group id="theme_files" label="30011">
        <setting id="theme_keyword" type="string" label="30104" help="30105">
          <level>0</level>
          <default>theme</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30104</heading>
          </control>
        </setting>
        <setting id="selection_mode" type="integer" label="30109" help="30121">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30110">0</option>
              <option label="30111">1</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="loop_theme" type="boolean" label="30112">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="random_start" type="boolean" label="30113" help="30122">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="volume" label="30012">
        <setting id="volume" type="integer" label="30106">
          <level>0</level>
          <default>60</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>100</maximum>
          </constraints>
          <control type="slider" format="percentage">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="fade_in_ms" type="integer" label="30107" help="30133">
          <level>0</level>
          <default>1500</default>
          <constraints>
            <minimum>0</minimum>
            <step>100</step>
